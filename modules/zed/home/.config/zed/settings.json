{
  "ssh_connections": [
    {
      "host": "nuc.siren-pollux.ts.net",
      "username": "alex",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/alex/Projects/tir/./"
          ]
        }
      ]
    }
  ],
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    }
  },
  "auto_install_extensions": {
    "nix": true,
    "rust": true,
    "toml": true,
    "jellybeans-vim": true,
    "git-firefly": true,
    "latex": true,
    "scala": true,
    "swift": true,
    "verilog": true,
    "darcula-dark": true,
    "dockerfile": true,
    "kotlin": true,
    "make": true,
    "proto": true,
    "starlark": true
  },
  "hour_format": "hour24",
  "vim_mode": true,
  "theme": {
    "dark": "Darcula Dark",
    "light": "One Light",
    "mode": "system"
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 20,
  "helix_mode": true,
  "terminal": {
    "alternate_scroll": "off",
    "blinking": "off",
    "button": false,
    "copy_on_select": false,
    "detect_venv": {
      "on": {
        "activate_script": "default",
        "directories": [
          ".env",
          "env",
          ".venv",
          "venv"
        ]
      }
    },
    "dock": "bottom",
    "option_as_meta": false,
    "shell": "system",
    "toolbar": {
      "title": true
    },
    "working_directory": "current_project_directory"
  },
  "ui_font_size": 18,
  "lsp": {
    "nix": {
      "binary": {
        "path_lookup": true
      }
    },
    "rust-analyzer": {
      "binary": {
        "path_lookup": true
      }
    }
  }
}
